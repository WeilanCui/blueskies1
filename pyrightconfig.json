{
  // Static type checking for the Django backend. See README "Type checking".
  // Mode is "standard". Some standard-mode diagnostics are downgraded to
  // "warning" ONLY where they fire on framework/stub limitations that cannot be
  // resolved without annotating production code (out of scope). Each downgrade
  // is justified inline by its dominant cause. Real-bug rules (undefined names,
  // optional subscript, index issues, missing imports, general type issues) are
  // kept at "error" so the pre-commit hook blocks genuine regressions.
  "include": ["backend"],
  "extraPaths": ["backend"],
  "exclude": [
    "**/migrations",
    "**/__pycache__",
    "**/node_modules",
    "frontend",
    "**/.venv",
    "**/venv"
  ],
  "typeCheckingMode": "standard",

  // Third-party libs without type stubs (celery, openai, requests, redis,
  // psycopg, django-environ, corsheaders). Silences stub-absence noise only.
  "reportMissingTypeStubs": "none",
  "reportMissingModuleSource": "none",

  // django-types does not synthesize reverse-relation / related-manager
  // accessors (e.g. compound.identifiers, compound.property_assertions).
  "reportAttributeAccessIssue": "warning",
  // django-environ env() overloads and Django TextChoices members typed as
  // (value, label) tuples rather than their str value.
  "reportArgumentType": "warning",
  // Inherited inner `Meta` class on abstract Django models (SourceMetadata).
  "reportIncompatibleVariableOverride": "warning",
  // DRF .data returns ReturnDict where annotations declare dict.
  "reportReturnType": "warning",
  "reportAssignmentType": "warning",
  // django-types models Constraint signatures (check/condition) loosely.
  "reportCallIssue": "warning",
  // ElementTree .text is str | None; guarded by `(x.text or "").strip()` which
  // pyright cannot narrow. Injected callables defaulted to None in __init__.
  "reportOptionalMemberAccess": "warning",
  "reportOptionalCall": "warning",
  // DRF base method override signature strictness (get_throttles return
  // covariance, get_value parameter name).
  "reportIncompatibleMethodOverride": "warning",
  // Celery @shared_task decorated functions expose .delay/.apply_async, which
  // celery (no stubs) does not advertise on FunctionType.
  "reportFunctionMemberAccess": "warning",

  "pythonVersion": "3.11"
}
